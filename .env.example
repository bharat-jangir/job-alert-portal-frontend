# Public site (Next.js) — dev port 3000 (npm run dev)
# URL of the backend API (no trailing slash). Also the target of the /api/* rewrite.
BACKEND_API_BASE_URL=http://localhost:5000

# Public URL of this site: canonical URLs, sitemap, Open Graph
SITE_URL=http://localhost:3000

# Shared secret for POST /internal/revalidate. Must equal REVALIDATE_SECRET on the backend.
REVALIDATE_SECRET=change-me

# Server-only. Must equal INTERNAL_API_KEY on the backend: lets this web
# server's read requests skip the API's per-IP rate limit.
API_INTERNAL_KEY=

# Branding and contact. Social/community links are hidden until you set them.
SITE_NAME=Sarkari Job Update
CONTACT_EMAIL=
TELEGRAM_URL=
WHATSAPP_URL=
FACEBOOK_URL=
TWITTER_URL=
YOUTUBE_URL=

# Google Search Console HTML-tag verification code (optional)
GOOGLE_SITE_VERIFICATION=
