# Public site (Next.js) — dev port 3000  (npm run dev)
# Copy to .env.local. NEXT_PUBLIC_* values are baked in at build time.

# URL of the backend API (no trailing slash). Also the target of the /api/* rewrite.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Public URL of this site: canonical URLs, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for POST /internal/revalidate. Must equal REVALIDATE_SECRET on the backend.
REVALIDATE_SECRET=change-me

# Server-only (never prefix with NEXT_PUBLIC_). Must equal INTERNAL_API_KEY on the backend: lets this web
# server's read requests skip the API's per-IP rate limit. Required in production, see the backend .env.example.
API_INTERNAL_KEY=

# Branding and contact (all optional). Social/community links are hidden until you set them.
NEXT_PUBLIC_SITE_NAME=Sarkari Job Update
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Google Search Console HTML-tag verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
